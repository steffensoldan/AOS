# Ignore temporary dialog threads
dialog/*
!dialog/README.md
!dialog/uaos-overhead-check/
!dialog/aos-optimierung/

# Windows/Node temp files
.DS_Store
Thumbs.db
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Projects folder containing separate git repositories
projects/

# Ignore secrets
.env
*.key
*.pem
secrets.json
scratch/

# Agent-Dialoge (dialog-lite): abgeschlossene Verlaeufe bleiben versioniert -
# sie sind Entscheidungsdokumente und sollen einen Klon ueberleben.
# Die Sonden-Sidecars sind Zwischenstand der laufenden Sondenphase.
dialoge/*.probe-*.json

# Geklontes Fremdrepo mit eigenem .git (MCP-Server dialog-lite).
# Nachbau nach docs/dialog-lite.md; lokale Abweichung als docs/dialog-lite-vorspann.patch.
dialog-lite-src/
